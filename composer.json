{
    "name": "jeffersongoncalves/laravel-gdpr-records",
    "description": "GDPR records of processing activities for Laravel (Art. 30): purposes, lawful bases, recipients, third-country transfers and erasure limits, joined with your declared personal data; DPO contact (Art. 37) and a privacy notice page (Arts. 13-14).",
    "keywords": [
        "laravel",
        "gdpr",
        "ropa",
        "records-of-processing",
        "article-30",
        "privacy-notice",
        "dpo"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-gdpr-records",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Simão Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\GdprRecords\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\GdprRecords\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\GdprRecords\\GdprRecordsServiceProvider"
            ],
            "aliases": {
                "GdprRecords": "JeffersonGoncalves\\GdprRecords\\Facades\\GdprRecords"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
